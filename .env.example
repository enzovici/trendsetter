# Database (docker-compose default)
DATABASE_URL=postgresql+asyncpg://trendsetter:trendsetter@localhost:5433/trendsetter

# Provider keys
SCRAPECREATORS_API_KEY=
APIFY_TOKEN=

# LLM / embeddings (M2+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Fernet key for OAuth token encryption at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Dashboard single-user auth
APP_PASSWORD=change-me
SESSION_SECRET=change-me-too

# Cloudflare R2 (M4 publishing)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
